<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_appointment_reminder" model="mail.template">
        <field name="name">Appointment Reminder</field>
        <field name="model_id" ref="model_clinic_appointment"/>
        <field name="subject">Reminder: Your appointment is tomorrow ({{ object.name }})</field>
        <!-- Email sending fixed -->
        <field name="email_from">{{ user.company_id.email or user.email }}</field>
        <field name="email_to">{{ object.patient_id.email }}</field>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; color: #2b2b2b; max-width: 600px;">
                <div style="background-color: #2c3e6e; color: #ffffff; padding: 18px 24px; border-radius: 6px 6px 0 0;">
                    <div style="font-size: 20px; font-weight: 700;">Appointment Reminder</div>
                </div>
                <div style="border: 1px solid #e2e4ec; border-top: none; padding: 24px; border-radius: 0 0 6px 6px;">
                    <p>Dear <strong><t t-out="object.patient_id.name"/></strong>,</p>
                    <p>This is a friendly reminder that you have an upcoming appointment scheduled for tomorrow.</p>

                    <table style="margin-top: 15px; margin-bottom: 15px;">
                        <tr>
                            <td style="padding-right: 15px; color: #5b6178;"><strong>Doctor:</strong></td>
                            <td>Dr. <t t-out="object.doctor_id.name"/></td>
                        </tr>
                        <tr>
                            <td style="padding-right: 15px; color: #5b6178;"><strong>Date / Time:</strong></td>
                            <td><t t-out="object.appointment_date"/></td>
                        </tr>
                        <tr>
                            <td style="padding-right: 15px; color: #5b6178;"><strong>Ref:</strong></td>
                            <td><t t-out="object.name"/></td>
                        </tr>
                    </table>

                    <p>Please arrive 10 minutes early. If you need to reschedule, please contact us.</p>
                    <p style="margin-top: 24px;">Warm regards,<br/><strong><t t-out="user.company_id.name"/></strong></p>
                </div>
            </div>
        </field>
    </record>
</odoo>