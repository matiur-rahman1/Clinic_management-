<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_appointment_reminder" model="ir.cron">
        <field name="name">Clinic: Send Appointment Reminders</field>
        <field name="model_id" ref="model_clinic_appointment"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_appointment_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>