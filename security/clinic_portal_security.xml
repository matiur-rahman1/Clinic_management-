<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_clinic_patient_portal" model="ir.rule">
            <field name="name">Portal: Own Patient</field>
            <field name="model_id" ref="model_clinic_patient"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="rule_clinic_appointment_portal" model="ir.rule">
            <field name="name">Portal: Own Appointments</field>
            <field name="model_id" ref="model_clinic_appointment"/>
            <field name="domain_force">[('patient_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="rule_clinic_prescription_portal" model="ir.rule">
            <field name="name">Portal: Own Prescriptions</field>
            <field name="model_id" ref="model_clinic_prescription_line"/>
            <field name="domain_force">[('patient_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
            <record id="rule_clinic_lab_test_portal" model="ir.rule">
            <field name="name">Portal: Own Lab Tests</field>
            <field name="model_id" ref="model_clinic_lab_test"/>
            <field name="domain_force">[('patient_id.partner_id', '=', user.partner_id.id)]</field>
           <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
    </data>
</odoo>