<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The PDF Action -->
    <record id="action_report_appointment" model="ir.actions.report">
        <field name="name">Appointment Slip</field>
        <field name="model">clinic.appointment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">clinic_management.report_appointment_document</field>
        <field name="report_file">clinic_management.report_appointment_document</field>
        <field name="print_report_name">'Appointment - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_clinic_appointment"/>
        <field name="binding_type">report</field>
    </record>

    <!-- The Design -->
    <template id="report_appointment_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="res_company"/>

                <div class="header">
                    <table style="width: 100%;">
                        <tr>
                            <td style="text-align: left;">
                                <h4><span t-field="company.name"/></h4>
                                <div style="font-size: 12px; color: gray;">
                                    <span t-field="company.street"/><br/>
                                    <span t-field="company.phone"/>
                                </div>
                            </td>
                            <td style="text-align: right;">
                                <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 50px;"/>
                            </td>
                        </tr>
                    </table>
                </div>

                <div class="article">
                    <div class="page" style="font-family: Arial, sans-serif;">

                        <div style="background-color: #2c3e6e; color: white; padding: 15px; text-align: center; margin-bottom: 20px;">
                            <h2 style="margin: 0;">Medical Appointment Slip</h2>
                        </div>

                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                            <tr>
                                <td style="width: 50%; vertical-align: top;">
                                    <h4 style="color: #2c3e6e; border-bottom: 1px solid #ccc;">Patient Details</h4>
                                    <p><strong>Name:</strong> <span t-field="o.patient_id.name"/></p>
                                    <p><strong>Age:</strong> <span t-field="o.patient_id.age"/></p>
                                    <p><strong>Blood Group:</strong> <span t-field="o.patient_id.blood_group"/></p>
                                    <p><strong>Phone:</strong> <span t-field="o.patient_id.phone"/></p>
                                </td>
                                <td style="width: 50%; vertical-align: top;">
                                    <h4 style="color: #2c3e6e; border-bottom: 1px solid #ccc;">Appointment Details</h4>
                                    <p><strong>Ref:</strong> <span t-field="o.name"/></p>
                                    <p><strong>Doctor:</strong> Dr. <span t-field="o.doctor_id.name"/></p>
                                    <p><strong>Date / Time:</strong> <span t-field="o.appointment_date"/></p>
                                    <p><strong>Status:</strong> <span t-field="o.state"/></p>
                                </td>
                            </tr>
                        </table>

                        <!-- Medical Notes -->
                        <div style="margin-top: 30px;">
                            <h4 style="color: #2c3e6e; border-bottom: 1px solid #ccc;">Medical Notes</h4>
                            <p style="border: 1px solid #ddd; padding: 10px; min-height: 60px; background-color: #f9f9f9;">
                                <span t-field="o.notes"/>
                            </p>
                        </div>

                        <!-- Prescription Table -->
                        <div t-if="o.prescription_ids" style="margin-top: 20px;">
                            <h4 style="color: #2c3e6e; border-bottom: 1px solid #ccc;">Rx (Prescription)</h4>
                            <table style="width: 100%; border-collapse: collapse;">
                                <thead>
                                    <tr style="background-color: #f0f0f0;">
                                        <th style="padding: 8px; text-align: left; border: 1px solid #ddd;">Medicine</th>
                                        <th style="padding: 8px; text-align: left; border: 1px solid #ddd;">Dosage</th>
                                        <th style="padding: 8px; text-align: left; border: 1px solid #ddd;">Duration</th>
                                        <th style="padding: 8px; text-align: left; border: 1px solid #ddd;">Instructions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.prescription_ids" t-as="line">
                                        <td style="padding: 8px; border: 1px solid #ddd;"><strong t-out="line.line_title"/></td>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><span t-field="line.dosage"/></td>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><span t-field="line.duration"/></td>
                                        <td style="padding: 8px; border: 1px solid #ddd;"><span t-field="line.instructions"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div style="margin-top: 60px; text-align: right;">
                            <!-- If the doctor uploaded a signature, show the image -->
                            <div t-if="o.doctor_id.signature" style="margin-bottom: 5px;">
                                <img t-att-src="image_data_uri(o.doctor_id.signature)" style="max-height: 80px; max-width: 200px;"/>
                            </div>
                            <!-- If no signature is uploaded, leave blank space -->
                            <div t-else="" style="height: 80px;"></div>

                            <div style="border-top: 1px solid #000; display: inline-block; padding-top: 5px; width: 200px; text-align: center;">
                                <strong>Dr. <span t-field="o.doctor_id.name"/></strong><br/>
                                <span t-field="o.doctor_id.specialty"/>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>