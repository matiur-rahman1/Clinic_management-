<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Drug catalog: a reference list for prescriptions (no stock, no selling). -->

    <record id="view_medicine_search" model="ir.ui.view">
        <field name="name">clinic.medicine.search</field>
        <field name="model">clinic.medicine</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Drug" filter_domain="['|', ('name', 'ilike', self), ('generic_name', 'ilike', self)]"/>
                <field name="generic_name"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_form" string="Form" context="{'group_by': 'form'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_medicine_list" model="ir.ui.view">
        <field name="name">clinic.medicine.list</field>
        <field name="model">clinic.medicine</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="generic_name"/>
                <field name="strength"/>
                <field name="form"/>
                <field name="default_dosage"/>
                <field name="default_duration"/>
                <field name="default_instructions" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_medicine_form" model="ir.ui.view">
        <field name="name">clinic.medicine.form</field>
        <field name="model">clinic.medicine</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Napa"/></h1>
                    </div>
                    <group>
                        <group string="Drug">
                            <field name="generic_name" placeholder="e.g. Paracetamol"/>
                            <field name="strength" placeholder="e.g. 500 mg"/>
                            <field name="form"/>
                        </group>
                        <group string="Prescribing defaults">
                            <field name="default_dosage" placeholder="e.g. 1+0+1"/>
                            <field name="default_duration" placeholder="e.g. 5 days"/>
                            <field name="default_instructions" placeholder="e.g. After meal"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1" placeholder="Warnings, interactions, brand alternatives..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_clinic_medicine" model="ir.actions.act_window">
        <field name="name">Drug Catalog</field>
        <field name="res_model">clinic.medicine</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_medicine_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first drug</p>
            <p>A quick reference list for writing prescriptions. Doctors can also type any drug that is not listed.</p>
        </field>
    </record>

    <menuitem id="menu_clinic_medicine" name="Drug Catalog" parent="menu_clinic_config" action="action_clinic_medicine" sequence="10"/>

    <!-- ============================================================ -->
    <!-- RX PROTOCOL TEMPLATES                                        -->
    <!-- ============================================================ -->
    <record id="view_rx_template_list" model="ir.ui.view">
        <field name="name">clinic.rx.template.list</field>
        <field name="model">clinic.rx.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="specialty" widget="badge"/>
                <field name="diagnosis"/>
                <field name="line_count" string="Medicines"/>
                <field name="follow_up_days"/>
            </list>
        </field>
    </record>

    <record id="view_rx_template_form" model="ir.ui.view">
        <field name="name">clinic.rx.template.form</field>
        <field name="model">clinic.rx.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Viral Fever &amp; URI"/></h1>
                    </div>
                    <group>
                        <group string="Protocol Info">
                            <field name="specialty"/>
                            <field name="follow_up_days"/>
                        </group>
                        <group string="Clinical">
                            <field name="chief_complaint" placeholder="Typical symptoms..."/>
                            <field name="diagnosis" placeholder="Standard diagnosis..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Standard Prescription (Rx)">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="medicine_id" string="From catalog" options="{'no_quick_create': True}"/>
                                    <field name="drug_name" required="1"/>
                                    <field name="strength"/>
                                    <field name="form"/>
                                    <field name="dosage"/>
                                    <field name="duration"/>
                                    <field name="instructions"/>
                                </list>
                            </field>
                        </page>
                        <page string="Standard Advice">
                            <field name="advice" placeholder="Standard patient instructions and lifestyle advice..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_clinic_rx_template" model="ir.actions.act_window">
        <field name="name">Rx Protocols</field>
        <field name="res_model">clinic.rx.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_clinic_rx_template" name="Rx Protocols" parent="menu_clinic_config" action="action_clinic_rx_template" sequence="20"/>
</odoo>